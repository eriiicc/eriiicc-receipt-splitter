{
  "expo": {
    "name": "Settled",
    "slug": "settled",
    "version": "1.0.0",
    "orientation": "portrait",
   "icon": "./assets/icon.png",
"splash": {
  "image": "./assets/splash.png",
  "resizeMode": "contain",
  "backgroundColor": "#1A4A3A"
},
    "scheme": "settled",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "Settled needs camera access to scan receipts.",
        "NSPhotoLibraryUsageDescription": "Settled needs photo library access to upload receipts.",
        "NSContactsUsageDescription": "Settled needs contacts access to invite people to split bills.",
        "LSApplicationQueriesSchemes": [
          "venmo",
          "cashapp",
          "zelle",
          "venmo",
          "cashapp",
          "zelle"
        ],
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.ericgr.settled"
    },
    "android": {
     "adaptiveIcon": {
  "foregroundImage": "./assets/adaptive-icon.png",
  "backgroundColor": "#1A4A3A"
}
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_CONTACTS",
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Settled needs camera access to scan receipts and QR codes."
        }
      ],
      [
  "@react-native-google-signin/google-signin",
  {
    "iosUrlScheme": "com.googleusercontent.apps.351911635604-hin3a2jgn1hc0ltjqpurn34c4rstit4k"
  }
],
      [
        "expo-contacts",
        {
          "contactsPermission": "Settled needs contacts access to invite people to split bills."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Settled needs photo library access to upload receipts.",
          "cameraPermission": "Settled needs camera access to scan receipts."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F2EDE0",
          "dark": {
            "backgroundColor": "#1A4A3A"
          }
        }
      ],
      "expo-web-browser",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2d6ad5e7-a1a6-4a93-a039-b8d7344c4807"
      }
    }
  }
}
