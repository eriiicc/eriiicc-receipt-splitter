{
  "expo": {
    "name": "Settled",
    "slug": "settled",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "settled",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Settled needs camera access to scan receipts.",
        "NSPhotoLibraryUsageDescription": "Settled needs photo library access to upload receipts.",
        "NSContactsUsageDescription": "Settled needs contacts access to invite people to split bills."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A4A3A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_CONTACTS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Settled needs camera access to scan receipts."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Settled needs contacts access to invite people to split bills."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Settled needs photo library access to upload receipts.",
          "cameraPermission": "Settled needs camera access to scan receipts."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F2EDE0",
          "dark": {
            "backgroundColor": "#1A4A3A"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}